{
  "name": "arthur-agent",
  "version": "0.2.0",
  "description": "Universal Human-in-the-Loop Approval Layer for AI Coding Agents via Telegram",
  "type": "module",
  "main": "dist/server/index.js",
  "bin": {
    "arthur": "dist/cli/arthur-cli.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/server/index.js",
    "dev": "tsx src/server/index.ts",
    "test": "tsx test/unit.test.ts && tsx test/policy.test.ts",
    "test:policy": "tsx test/policy.test.ts",
    "test:unit": "tsx test/unit.test.ts",
    "init": "tsx src/cli/arthur-cli.ts init"
  },
  "keywords": [
    "ai",
    "agent",
    "approval",
    "human-in-the-loop",
    "telegram",
    "antigravity",
    "claude-code",
    "cursor"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
