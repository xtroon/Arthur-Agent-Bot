# Milo Server Configuration
PORT=4000
HOST=127.0.0.1

# Slack Bot Integration (Optional)
# If left empty, Milo runs in web-dashboard-only mode.
SLACK_ENABLED=true
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_SIGNING_SECRET=your-slack-signing-secret
SLACK_CHANNEL_ID=C0123456789

# Slack Socket Mode (Recommended: No ngrok or public URLs required!)
# Generated under "Basic Information" -> "App-Level Tokens" with scope "connections:write"
SLACK_APP_TOKEN=xapp-your-app-level-token
