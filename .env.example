# Arthur Server Configuration
PORT=4000
HOST=127.0.0.1

# Telegram Mobile Bot Integration
# 1. Message @BotFather on Telegram and send /newbot to get your token
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# 2. Send /start to your bot in Telegram to get your Chat ID (or run 'npx arthur init' to auto-detect!)
TELEGRAM_CHAT_ID=your-telegram-chat-id

# Smart Policy Settings
ARTHUR_AUTO_APPROVE_SAFE=true
ARTHUR_TIMEOUT_SEC=180
ARTHUR_FALLBACK=deny
